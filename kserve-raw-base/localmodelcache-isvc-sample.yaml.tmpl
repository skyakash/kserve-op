apiVersion: serving.kserve.io/v1beta1
kind: InferenceService
metadata:
  name: sklearn-iris-cached
  annotations:
    serving.kserve.io/deploymentMode: RawDeployment
spec:
  predictor:
    sklearn:
      # IMPORTANT: this MUST match the LocalModelCache's spec.sourceModelUri.
      # When localModel.enabled=true in the inferenceservice-config ConfigMap,
      # KServe's defaults webhook matches by URI and auto-rewrites this ISVC
      # to mount the cache's PVC directly — no internet pull at startup.
      storageUri: gs://kfserving-examples/models/sklearn/1.0/model
