# Air-gapped variant of LocalModelCache. Source is a pre-populated PVC
# in the operator's namespace, not a gs:// URI. See
# localmodelcache-offline-source-pvc-sample.yaml.tmpl for how to populate
# the source PVC.
#
# Note: requires LocalModelNodeGroup `default-worker` from
# localmodelcache-nodegroup-sample.yaml.tmpl already applied.
apiVersion: serving.kserve.io/v1alpha1
kind: LocalModelCache
metadata:
  name: sklearn-iris-cache-offline
spec:
  # pvc://<pvc-name>/<path-inside-pvc>. The path AFTER the PVC name must
  # match the directory that holds model.joblib inside the source PVC.
  sourceModelUri: pvc://offline-models-pvc/sklearn/iris/1.0/model
  modelSize: 100Mi
  nodeGroups:
    - default-worker
