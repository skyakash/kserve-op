---
# Continuous chown DaemonSet for the per-node LocalModelCache hostpath.
#
# !!! DEV CLUSTERS ONLY !!!
#
# Production CSI-backed StorageClasses (EBS, GCE PD, Azure Disk,
# OpenShift LocalVolume, etc.) propagate fsGroup chown correctly through
# the volume tree — this helper is unnecessary there and you should
# skip applying it.
#
# This helper is for hostpath-backed dev clusters (Docker Desktop, kind,
# minikube) where the LocalModelCache flow has a race:
#
#   1. User chowns /var/lib/kserve/local-models to 1000:1000 once.
#   2. User applies LocalModelCache CR.
#   3. localmodel-agent (runs as root) creates models/<cache>/ subdirs
#      — owned root:root.
#   4. Download Job (runs as UID 1000) tries to write into the subdir
#      → Permission denied → cache enters NodeDownloadError.
#
# A single chown can't close the race because the agent populates subdirs
# on its own cadence. This DaemonSet runs a continuous chown loop on each
# labeled worker. Apply it BEFORE the LocalModelCache CR; delete it AFTER
# the cache reaches copies.available == N-workers.
#
# nodeSelector matches the same label the localmodel-agent uses (set on
# workers via `kubectl label node <name> kserve/localmodel=worker`), so the
# helper schedules exactly where the agent runs.
apiVersion: apps/v1
kind: DaemonSet
metadata:
  name: chown-hostpath-helper
  namespace: kserve-localmodel-jobs
  labels:
    app: chown-hostpath-helper
    dev-only: "true"
spec:
  selector:
    matchLabels:
      app: chown-hostpath-helper
  template:
    metadata:
      labels:
        app: chown-hostpath-helper
        dev-only: "true"
    spec:
      nodeSelector:
        kserve/localmodel: worker
      # Tolerate common dev-cluster taints (control-plane on single-node
      # kind clusters, NoExecute during node-not-ready windows).
      tolerations:
        - key: node-role.kubernetes.io/control-plane
          operator: Exists
          effect: NoSchedule
        - operator: Exists
          effect: NoExecute
      restartPolicy: Always
      terminationGracePeriodSeconds: 5
      containers:
        - name: chown
          image: busybox:1.36
          # Run as root so we can chown the hostpath. Minimal privilege —
          # no capabilities beyond what busybox needs for chown.
          securityContext:
            runAsUser: 0
            runAsGroup: 0
            privileged: false
          command:
            - /bin/sh
            - -c
            - |
              set -eu
              echo "chown-hostpath-helper starting on node ${NODE_NAME}"
              while true; do
                # 1000:1000 matches the storage-initializer UID/GID.
                # -R because the localmodel-agent keeps creating subdirs.
                chown -R 1000:1000 /host-models 2>/dev/null || true
                sleep 30
              done
          env:
            - name: NODE_NAME
              valueFrom:
                fieldRef:
                  fieldPath: spec.nodeName
          volumeMounts:
            - name: host-models
              mountPath: /host-models
          resources:
            requests:
              cpu: 1m
              memory: 8Mi
            limits:
              cpu: 50m
              memory: 32Mi
      volumes:
        - name: host-models
          hostPath:
            # MUST match LocalModelNodeGroup.spec.persistentVolumeSpec.hostPath.path.
            path: /var/lib/kserve/local-models
            type: DirectoryOrCreate
