apiVersion: serving.kserve.io/v1alpha1
kind: LocalModelNodeGroup
metadata:
  name: default-worker
spec:
  # Upper bound on total node storage this group is allowed to consume.
  storageLimit: 5Gi
  persistentVolumeSpec:
    accessModes: [ReadWriteOnce]
    capacity:
      storage: 1Gi
    storageClassName: hostpath        # Docker Desktop default; change per cluster
    persistentVolumeReclaimPolicy: Delete
    volumeMode: Filesystem
    hostPath:
      path: /var/lib/kserve/local-models
      type: DirectoryOrCreate
    nodeAffinity:
      required:
        nodeSelectorTerms:
          - matchExpressions:
              - key: kserve/localmodel
                operator: In
                values: [worker]
  persistentVolumeClaimSpec:
    accessModes: [ReadWriteOnce]
    # MUST match persistentVolumeSpec.storageClassName above — otherwise
    # the PVC defaults to the cluster default class and never binds to
    # the static PV the controller creates.
    storageClassName: hostpath
    resources:
      requests:
        storage: 1Gi
